generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  themes           SoundTheme[]
  generations      Generation[]
  referenceTracks  ReferenceTrack[]
}

model SoundTheme {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String   @db.Text
  genres           String[]
  moods            String[]
  era              String?
  tempo            String?
  instruments      String[]
  exampleUrls      String[]
  exampleBlobUrls  String[]
  promptBase       String   @db.Text
  isDefault        Boolean  @default(false)
  referenceTrackId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations    Generation[]
  referenceTrack ReferenceTrack? @relation(fields: [referenceTrackId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ReferenceTrack {
  id                  String         @id
  userId              String
  originalFilename    String
  blobUrl             String
  mimeType            String
  fileSize            Int
  duration            Float?
  bpm                 Float?
  musicalKey          String?
  genre               String?
  mood                String?
  energy              String?
  instrumentation     String[]
  descriptors         String[]
  analysisStatus      AnalysisStatus @default(PENDING)
  analysisRawResponse Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  themes SoundTheme[]

  @@index([userId])
  @@index([analysisStatus])
}

model Generation {
  id                 String           @id @default(cuid())
  userId             String
  themeId            String?
  status             GenerationStatus @default(PENDING)
  prompt             String           @db.Text
  contextDescription String?          @db.Text
  duration           Int              @default(15)
  model              String           @default("musicgen")
  replicateId        String?
  audioUrl           String?
  audioFormat        String           @default("mp3")
  errorMessage       String?          @db.Text
  metadata           Json?
  createdAt          DateTime         @default(now())
  completedAt        DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme SoundTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([themeId])
  @@index([status])
  @@index([replicateId])
}

enum GenerationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
